{
  "name": "sf-cicd-lab",
  "image": "sf-dev:2.159.7-cc2.1.323-g4",
  "remoteUser": "dev",
  "updateRemoteUserUID": true,

  // Org logins live in volumes that belong to THIS project only (guardrail G7).
  // Rebuilding the container keeps them; other projects can't see them.
  "mounts": [
    "source=sf-auth-${devcontainerId},target=/home/dev/.sfdx,type=volume",
    "source=sf-state-${devcontainerId},target=/home/dev/.sf,type=volume",
    // Claude Code login, settings and session history, also per project
    "source=claude-config-${devcontainerId},target=/home/dev/.claude,type=volume"
  ],

  // CLAUDE_CONFIG_DIR keeps .claude.json inside the volume (otherwise it is lost on rebuild).
  // DISABLE_AUTOUPDATER keeps Claude Code at the version pinned in the image.
  // Never set ANTHROPIC_API_KEY here: Claude Code would bill the API instead of the Pro subscription.
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/dev/.claude",
    "DISABLE_AUTOUPDATER": "1"
  },

  // OAuth callback for "sf org login web"
  "forwardPorts": [1717],
  "portsAttributes": {
    "1717": { "label": "Salesforce login callback", "onAutoForward": "silent" }
  },

  "customizations": {
    "vscode": {
      // Same tools as the Husky pre-commit hook (Prettier, ESLint) so editor and commit agree.
      "extensions": [
        "salesforce.salesforcedx-vscode",
        "salesforce.sfdx-code-analyzer-vscode",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "redhat.vscode-xml",
        "financialforce.lana",
        // The Claude Code panel runs its OWN bundled CLI, whose version = the extension version.
        // Pin it to the same version as the CLI in the image (D15), so terminal and panel behave the same.
        "anthropic.claude-code@2.1.323"
      ],
      "settings": {
        "salesforcedx-vscode-apex.java.home": "/usr/lib/jvm/java-17-openjdk-amd64"
      }
    }
  },

  // npm ci: installs the exact versions from package-lock.json (Prettier, ESLint, Jest, Husky hooks)
  "postCreateCommand": "npm ci && sf --version && sf plugins && java -version && python3 --version && git --version"
}
